{
  "manifest_version": 3,
  "name": "Sabaq Blocker",
  "version": "1.0.1",
  "description": "Blocks the distracting sites you choose in Sabaq Study Desk while its focus timer runs.",
  "homepage_url": "https://sabaq-study.pages.dev/",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" },
    "default_title": "Sabaq Blocker",
    "default_popup": "blocked.html?popup=1"
  },
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://sabaq-study.pages.dev/*", "https://albaraaroury190-tech.github.io/sabaq/*", "http://localhost:8080/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
